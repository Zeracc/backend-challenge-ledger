{
  "name": "backend-challenge-ledger",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "Distributed wagering processor for the Jungle Gaming backend challenge",
  "license": "UNLICENSED",
  "packageManager": "bun@1.3.14",
  "engines": {
    "bun": ">=1.0.0 <2"
  },
  "scripts": {
    "build": "nest build",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "lint": "eslint src test --max-warnings=0",
    "start": "bun src/main.ts",
    "start:dev": "bun --watch src/main.ts",
    "start:prod": "bun dist/main.js",
    "test": "bun test",
    "test:e2e": "bun test test/smoke",
    "test:integration": "bun test test/integration",
    "test:unit": "bun test src",
    "test:coverage": "bun test --coverage",
    "typecheck": "tsc --noEmit --project tsconfig.json"
  },
  "dependencies": {
    "@mikro-orm/core": "7.1.15",
    "@mikro-orm/migrations": "7.1.15",
    "@mikro-orm/nestjs": "7.1.0",
    "@mikro-orm/postgresql": "7.1.15",
    "@nestjs/common": "12.0.1",
    "@nestjs/core": "12.0.1",
    "@nestjs/platform-express": "12.0.1",
    "decimal.js": "10.6.0",
    "reflect-metadata": "0.2.2",
    "rxjs": "7.8.2"
  },
  "devDependencies": {
    "@eslint/js": "10.0.1",
    "@mikro-orm/cli": "7.1.15",
    "@nestjs/cli": "12.0.0",
    "@nestjs/testing": "12.0.1",
    "@types/bun": "1.3.14",
    "@types/node": "26.4.1",
    "eslint": "10.9.1",
    "prettier": "3.9.6",
    "typescript": "6.0.3",
    "typescript-eslint": "8.69.0"
  }
}
